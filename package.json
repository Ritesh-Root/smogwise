  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  }
}
