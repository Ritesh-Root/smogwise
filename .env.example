# Copy to .env for local development (`npm run dev` reads it). Never commit real values.

# Google Cloud project that hosts Vertex AI (Gemini).
GOOGLE_CLOUD_PROJECT=your-project-id

# API key for the Air Quality and Geocoding APIs, restricted to those two APIs.
MAPS_API_KEY=your-restricted-maps-key

# Optional.
GEMINI_MODEL=gemini-3.8-flash
VERTEX_LOCATION=global
PORT=8080
